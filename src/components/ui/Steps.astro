---
interface Step {
  t: string;
  d: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<!-- Ref: blok cara order — list bernomor ber-rule -->
<ol class="border-t border-sage">
  {
    steps.map((s, i) => (
      <li class="reveal grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4 border-b border-sage py-5 md:gap-8" style={`--i:${i}`}>
        <span class="num pt-1 text-sm text-accent">{String(i + 1).padStart(2, '0')}</span>
        <div class="min-w-0">
          <p class="text-base font-medium tracking-tight text-ink">{s.t}</p>
          <p class="mt-1 max-w-[62ch] text-sm leading-relaxed text-ink/65">{s.d}</p>
        </div>
      </li>
    ))
  }
</ol>
