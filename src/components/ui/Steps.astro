---
interface Step { t: string; d: string }
interface Props { steps: Step[] }
const { steps } = Astro.props;
---
<ol class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
  {steps.map((st, i) => (
    <li class="bg-zinc-900 border border-white/10 rounded-[2.5rem] p-6">
      <p class="font-mono text-xs tracking-[0.2em] text-sky-400">0{i + 1}</p>
      <p class="mt-3 font-semibold text-lg tracking-tight text-white">{st.t}</p>
      <p class="mt-1 text-base text-zinc-400 leading-relaxed">{st.d}</p>
    </li>
  ))}
</ol>
