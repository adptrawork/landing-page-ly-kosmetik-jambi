  )
}
{
  name === 'phone' && (
    <svg {...common}>
      <path d="M5.5 4h3.2l1.6 4-2.2 1.5a11.5 11.5 0 0 0 4.6 4.6l1.5-2.2 4 1.6v3.2a1.3 1.3 0 0 1-1.4 1.3A15.8 15.8 0 0 1 4.2 5.4 1.3 1.3 0 0 1 5.5 4Z" />
    </svg>
  )
}
{
  name === 'menu' && (
    <svg {...common}>
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  )
}
{
  name === 'close' && (
    <svg {...common}>
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  )
}
{
  name === 'arrow' && (
    <svg {...common}>
      <path d="M4.5 12h15M13.5 6l6 6-6 6" />
    </svg>
  )
}
{
  name === 'search' && (
    <svg {...common}>
      <circle cx="11" cy="11" r="6.5" />
