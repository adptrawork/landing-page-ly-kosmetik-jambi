---
import Icon from './Icon.astro';

interface Item {
  q: string;
  a: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="border-t border-sage">
  {
    items.map((f) => (
      <details class="faq group border-b border-sage">
        <summary class="flex items-center justify-between gap-4 py-4">
          <span class="text-base font-medium tracking-tight text-ink">{f.q}</span>
          <Icon name="plus" size={18} class="plus text-accent" />
        </summary>
        <p class="max-w-[68ch] pb-4 text-sm leading-relaxed text-ink/65">{f.a}</p>
      </details>
    ))
  }
</div>
