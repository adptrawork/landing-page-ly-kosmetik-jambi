---
import Icon from './Icon.astro';
import { business, waLink } from '../../data/business';

interface P {
  name: string;
  price: string;
  badge: string;
  stock: string;
  image: string;
  alt: string;
  w: number;
  h: number;
  source: string;
}
interface Props {
  p: P;
  index: number;
  /** Kategori turunan untuk filter (opsional) */
  group?: string;
}

const { p, index, group } = Astro.props;
const no = String(index + 1).padStart(2, '0');
// "jenis" diturunkan dari nama produk (menghapus akhiran "Series") — tidak mengubah data sumber.
const type = p.name.replace(/\s*Series$/i, '');
const msg = waLink(`Halo ${business.name}, saya mau tanya ${p.name} (${p.price}). Apakah ready stok grosir?`);
---

<!-- Ref: baris katalog bernomor — kolom mono (jenis → nama → harga/status → CTA) -->
<li
  class="reveal rule transition-colors hover:bg-sage/25"
  style={`--i:${index}`}
  data-group={group}
  data-name={p.name}
>
  <div
    class="grid grid-cols-[2.25rem_minmax(0,1fr)] items-start gap-x-4 gap-y-3 py-5 md:grid-cols-[2.25rem_4.5rem_8rem_minmax(0,1fr)_9.5rem_auto] md:items-center md:gap-x-6 md:py-6"
  >
    <span class="num pt-1 text-xs text-ink/70 md:pt-0">{no}</span>

    <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] items-center gap-4 md:contents">
      <div class="h-[4.5rem] w-[4.5rem] overflow-hidden bg-sage/50">
        <img
          src={p.image}
          alt={p.alt}
          width={p.w}
          height={p.h}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>

      <div class="min-w-0 md:contents">
        <p class="label">{type}</p>
        <h2 class="min-w-0 text-[1.0625rem] font-medium leading-snug tracking-tight text-ink md:self-center">
          {p.name}
          <span class="mt-1 block text-[11px] font-normal leading-snug tracking-normal text-ink/70">{p.source}</span>
        </h2>
        <p class="num text-sm text-ink/80">
          {p.price}
          <span class="mt-1 block text-[11px] tracking-normal text-ink/70">{p.badge} · {p.stock}</span>
        </p>
      </div>
    </div>

    <a
      href={msg}
      rel="noopener"
      data-wa
      class="col-span-2 inline-flex min-h-[44px] items-center justify-center gap-2 border border-ink/25 px-4 text-sm font-medium text-ink transition-colors hover:border-accent hover:bg-accent hover:text-paper active:scale-[0.98] md:col-span-1 md:justify-self-end"
    >
      <span>Tanya via WA</span>
      <Icon name="arrow" size={16} />
    </a>
  </div>
</li>
