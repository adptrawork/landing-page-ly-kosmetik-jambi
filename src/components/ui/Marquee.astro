---
interface Props { items: string[] }
const { items } = Astro.props;
const row = [...items, ...items];
---
<div class="marquee bg-sky-950 border-y border-white/10" aria-hidden="true">
  <div class="marquee-track py-3">
    {row.map((m) => (
      <span class="font-mono text-xs tracking-[0.2em] uppercase text-sky-400 border border-white/10 text-zinc-300 rounded-full px-4 py-2 whitespace-nowrap">{m}</span>
    ))}
  </div>
</div>
