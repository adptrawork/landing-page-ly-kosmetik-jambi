---
import Icon from './Icon.astro';
import { business } from '../../data/business';

interface Props {
  embed: string;
}
const { embed } = Astro.props;
---

<!-- Ref: MapFacade — peta dimuat hanya setelah diklik (tanpa iframe Google Maps langsung) -->
<div
  data-mapfacade
  data-src={embed}
  data-title={`Peta lokasi ${business.name}`}
  class="relative aspect-[16/10] w-full overflow-hidden border border-sage bg-sage/40"
>
  <button
    data-mapbtn
    type="button"
    class="group/map block h-full w-full text-left cursor-pointer"
  >
    <img
      src={business.ogImage}
      alt=""
      aria-hidden="true"
      width="800"
      height="500"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <span
      class="absolute inset-0 flex flex-col justify-end gap-2 p-5 sm:p-6"
      style="background:linear-gradient(to top, rgba(36,38,32,0.88), rgba(36,38,32,0.35) 55%, rgba(36,38,32,0.05))"
    >
      <span class="label !text-paper/75">Peta lokasi — klik untuk memuat Google Maps</span>
      <span class="max-w-[46ch] text-sm leading-snug text-paper">{business.address}</span>
      <span class="mt-1 inline-flex min-h-[44px] items-center justify-center gap-2 self-start bg-paper px-5 text-sm font-medium text-ink transition-transform group-active/map:scale-[0.98]">
        <Icon name="pin" size={16} />
        <span>Muat Peta</span>
      </span>
    </span>
  </button>
</div>
