---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, promos, waLink } from '../data/business';
---
<BaseLayout title={`Promo — ${business.title}`} description={`Promo ${business.name}: status info menyusul, placeholder jangan jadi acuan harga.`} canonicalPath="/promo" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <p class="text-sm font-medium text-sky-500 reveal">Promo</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-extrabold text-white max-w-[20ch] reveal d-1">Promo {business.name}</h1>
    <p class="mt-3 text-base text-zinc-400 leading-relaxed max-w-[65ch]">Semua promo masih Info menyusul — placeholder, bukan acuan harga.</p>
    <div class="refract mt-8 bg-zinc-900 border border-white/10 rounded-[2rem] divide-y divide-white/10 overflow-hidden">
      {promos.map((m, i) => (
        <div class:list={["reveal flex flex-col md:flex-row md:items-center gap-3 p-5 md:p-6"]} style={`animation-delay:${i * 0.08}s`}>
          <div class="flex-1">
            <p class="text-[11px] font-medium text-sky-500">{m.status}</p>
            <h2 class="font-semibold tracking-tight text-white">{m.title}</h2>
            <p class="text-sm text-zinc-400">{m.desc}</p>
          </div>
          <a href={waLink(`Halo ${business.name}, saya mau tanya promo: ${m.title}.`)} class="shrink-0 border border-white/20 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Tanya via WA</a>
        </div>
      ))}
    </div>
    <div class="refract mt-6 bg-zinc-900 border border-dashed border-white/20 rounded-[2rem] p-10 text-center reveal">
      <svg class="mx-auto text-zinc-500" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 9h16v11H4z"/><path d="M4 9l2-5h12l2 5M12 4v15"/></svg>
      <p class="mt-4 font-bold text-white tracking-tight text-lg">Promo resmi belum ada</p>
      <p class="mt-2 text-base text-zinc-400 max-w-[65ch] mx-auto">Halaman ini akan update setelah data resmi terverifikasi. Minta update via WA sementara.</p>
      <a href={waLink(`Halo ${business.name}, minta update info promo resmi.`)} class="mt-5 inline-block bg-sky-700 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Minta Update</a>
    </div>
  </section>
</BaseLayout>
