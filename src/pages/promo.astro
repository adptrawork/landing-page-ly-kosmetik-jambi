---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Kicker from '../components/ui/Kicker.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Steps from '../components/ui/Steps.astro';
import { business, promos, waLink } from '../data/business';

const title = 'Promo & Info Grosir Ly Kosmetik Jambi — Harga & Stok';
const description = `Halaman promo ${business.name}: status tier promo, alur klaim, dan catatan harga. Semua promo masih info menyusul — konfirmasi sebelum order via WhatsApp.`;

const steps = [
  { t: 'Catat tier promo', d: 'Tandai nomor dan judul tier yang ingin diklaim dari daftar di atas.' },
  { t: 'Kirim klaim via WhatsApp', d: 'Tombol klaim membuka WhatsApp dengan judul promo yang sudah terisi otomatis.' },
  { t: 'Tunggu konfirmasi admin', d: 'Admin memastikan promo masih berlaku, harga final, dan ketersediaan stok.' },
];
---

<!-- Ref: utilitarian catalog, promo sebagai list bernomor ber-rule (bukan kartu) -->

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/promo"
  image={business.ogImage}
  breadcrumbs={[{ name: 'Beranda', path: '/' }, { name: 'Promo', path: '/promo' }]}
>
  <section class="shell py-10 sm:py-14 md:py-16" aria-labelledby="promo-h">
    <Kicker no="Promo" label={`${promos.length} tier — status menyusul`} />
    <h1
      id="promo-h"
      class="mt-4 max-w-[24ch] text-[2.1rem] font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl"
    >
      Promo & harga grosir Ly Kosmetik Jambi
    </h1>
    <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-ink/70">
      Belum ada promo resmi yang terverifikasi. Daftar di bawah adalah kerangka tier yang akan diperbarui setelah data
      toko terkonfirmasi — harga final selalu dikonfirmasi admin via WhatsApp.
    </p>
  </section>

  <!-- 01 Daftar tier promo -->
  <section class="shell pb-10 sm:pb-14" aria-labelledby="tier-h">
    <div class="border-t border-ink/15 pt-6">
      <SectionHead
        no="01"
        kicker="Tier promo"
        title="Daftar promo"
        desc="Setiap baris menampilkan status, judul, dan tombol klaim. Status menyusul berarti belum ada data resmi."
        id="tier-h"
      />
    </div>

    <ol class="mt-8 border-t border-sage">
      {
        promos.map((m, i) => (
          <li class="reveal border-b border-sage" style={`--i:${i}`}>
            <div class="grid grid-cols-[2.25rem_minmax(0,1fr)] items-start gap-x-4 gap-y-3 py-5 md:grid-cols-[2.25rem_minmax(0,1fr)_auto] md:items-center md:gap-x-6 md:py-6">
              <span class="num pt-1 text-xs text-ink/70 md:pt-0">{String(i + 1).padStart(2, '0')}</span>
              <div class="min-w-0">
                <p class="label">Status: {m.status}</p>
                <h2 class="mt-1 text-[1.0625rem] font-medium leading-snug tracking-tight text-ink">{m.title}</h2>
                <p class="mt-1 max-w-[62ch] text-sm leading-relaxed text-ink/65">{m.desc}</p>
              </div>
              <a
                href={waLink(`Halo ${business.name}, saya mau tanya promo: ${m.title}. Apakah masih berlaku?`)}
                rel="noopener"
                data-wa
                class="col-span-2 inline-flex min-h-[44px] items-center justify-center gap-2 border border-ink/25 px-4 text-sm font-medium text-ink transition-colors hover:border-accent hover:bg-accent hover:text-paper active:scale-[0.98] md:col-span-1 md:justify-self-end"
              >
                <span>Klaim via WA</span>
                <Icon name="arrow" size={16} />
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 02 Cara klaim -->
  <section class="shell pb-10 sm:pb-14" aria-labelledby="klaim-h">
    <div class="border-t border-ink/15 pt-6">
      <SectionHead no="02" kicker="Cara klaim" title="Alur klaim promo" id="klaim-h" />
    </div>
    <div class="mt-8">
      <Steps steps={steps} />
    </div>
  </section>

  <!-- 03 Catatan -->
  <section class="shell pb-14 sm:pb-20" aria-labelledby="catatan-h">
    <div class="border-t border-ink/15 pt-6">
      <h2 id="catatan-h" class="text-xl font-semibold tracking-tight text-ink sm:text-2xl">Catatan penting</h2>
      <ul class="mt-5 border-t border-sage">
        <li class="border-b border-sage py-3 text-sm leading-relaxed text-ink/70">
          Harga dapat berubah — konfirmasi via WhatsApp toko sebelum order.
        </li>
        <li class="border-b border-sage py-3 text-sm leading-relaxed text-ink/70">
          Promo dapat berakhir sewaktu-waktu mengikuti kebijakan toko.
        </li>
        <li class="border-b border-sage py-3 text-sm leading-relaxed text-ink/70">
          Tangkapan layar halaman ini bukan bukti klaim harga.
        </li>
      </ul>
      <p class="mt-6 text-sm leading-relaxed text-ink/65">
        Butuh info cepat?
        <a
          href={waLink(`Halo ${business.name}, boleh info promo dan harga grosir terbaru?`)}
          rel="noopener"
          data-wa
          class="text-ink underline decoration-rust decoration-1 underline-offset-4 hover:text-accent">Tanya promo via WhatsApp</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>
