---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Kicker from '../components/ui/Kicker.astro';
import { business, waLink } from '../data/business';

const cta = waLink(`Halo ${business.name}, saya butuh bantuan menemukan halaman atau produk.`);
---

<!-- Ref: utilitarian catalog, halaman 404 ringkas dengan NAP tetap terlihat -->

<BaseLayout
  title="404 — Halaman tidak ditemukan | Ly Kosmetik Jambi Grosir"
  description="Halaman yang Anda cari tidak ditemukan di situs Ly Kosmetik Jambi. Kembali ke katalog produk grosir atau hubungi admin via WhatsApp untuk bantuan."
  canonicalPath="/404"
>
  <section class="shell flex min-h-[60dvh] items-center py-16 sm:py-20" aria-labelledby="nf-h">
    <div class="max-w-[52ch]">
      <Kicker no="404" label="Halaman tidak ditemukan" />
      <h1 id="nf-h" class="mt-4 text-[2.1rem] font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl">
        Halaman ini tidak tersedia
      </h1>
      <p class="mt-5 text-base leading-relaxed text-ink/70">
        Tautan mungkin sudah berubah atau salah ketik. Kembali ke daftar katalog produk grosir, atau tanyakan langsung
        ke admin via WhatsApp bila Anda mencari produk tertentu.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/katalog"
          class="inline-flex min-h-[48px] items-center gap-2 bg-accent px-6 text-sm font-medium text-paper transition-transform duration-200 hover:bg-ink active:scale-[0.98]"
        >
          <span>Buka katalog</span>
          <Icon name="arrow" size={17} />
        </a>
        <a
          href="/"
          class="inline-flex min-h-[48px] items-center gap-2 border border-ink/25 px-6 text-sm font-medium text-ink transition-colors hover:border-ink active:scale-[0.98]"
        >
          <span>Kembali ke beranda</span>
        </a>
        <a
          href={cta}
          rel="noopener"
          data-wa
          class="inline-flex min-h-[48px] items-center gap-2 text-sm text-ink underline decoration-rust decoration-1 underline-offset-4 hover:text-accent"
        >
          <Icon name="whatsapp" size={16} />
          <span>Tanya via WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
