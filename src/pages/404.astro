---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Halaman tidak ditemukan | Ly Kosmetik Jambi" description="Halaman tidak ditemukan di Ly Kosmetik Jambi. Kembali ke daftar sementara.">
  <section class="max-w-7xl mx-auto px-4 py-20 min-h-[70dvh] grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
    <div class="md:col-span-7">
      <p class="text-sm font-medium text-sky-500">404</p>
      <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-extrabold text-white">Halaman tidak ditemukan</h1>
      <p class="mt-3 text-base text-zinc-400 max-w-[65ch]">Tautan mungkin berubah. Kembali ke beranda atau tanya via WA sementara.</p>
      <div class="mt-6 flex flex-wrap gap-3"><a href="/" class="bg-sky-700 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Beranda</a><a href="/katalog" class="border border-white/20 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Katalog</a></div>
    </div>
  </section>
</BaseLayout>
