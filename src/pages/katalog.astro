---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Kicker from '../components/ui/Kicker.astro';
import ProductRow from '../components/ui/ProductRow.astro';
import { business, products, waLink } from '../data/business';
import { groupedCatalog, groupOf } from '../data/catalog';

const title = 'Katalog Produk Ly Kosmetik Jambi — Grosir Skincare';
const description = `Katalog ${business.name}: ${products.length} produk skincare & perawatan dengan filter kategori dan pencarian cepat. Harga estimasi, konfirmasi stok via WhatsApp.`;

const filters = ['Semua', ...groupedCatalog.map((g) => g.name)];
const emptyCta = waLink(`Halo ${business.name}, saya cari produk yang belum ada di katalog. Boleh info katalog lengkap?`);
---

<!-- Ref: utilitarian catalog, list bernomor + filter aria-pressed + data mono -->

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/katalog"
  image={business.ogImage}
  breadcrumbs={[{ name: 'Beranda', path: '/' }, { name: 'Katalog', path: '/katalog' }]}
>
  <section class="shell py-10 sm:py-14 md:py-16" aria-labelledby="katalog-h">
    <Kicker no="Katalog" label={`${products.length} produk`} />
    <h1
      id="katalog-h"
      class="mt-4 max-w-[24ch] text-[2.1rem] font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl"
    >
      Daftar katalog produk Ly Kosmetik Jambi
    </h1>
    <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-ink/70">
      Setiap baris menampilkan jenis, nama, harga estimasi, dan tombol tanya stok. Semua harga bertanda estimasi belum
      final — <span class="mark">info menyusul</span> — dan wajib dikonfirmasi admin via WhatsApp.
    </p>

    <!-- Filter sederhana: tombol kategori aria-pressed + pencarian nama -->
    <div class="mt-8 border-y border-sage py-4">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter kategori produk">
          {
            filters.map((f, i) => (
              <button
                type="button"
                data-filter={f}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class="filter-btn min-h-[44px] border border-ink/25 px-4 text-sm text-ink/75 transition-colors hover:border-ink active:scale-[0.98] aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-paper"
              >
                {f}
              </button>
            ))
          }
        </div>

        <div role="search" class="w-full lg:w-72">
          <label for="filter-q" class="sr-only">Cari nama produk</label>
          <div class="flex items-center gap-2 border border-ink/25 px-3 focus-within:border-accent">
            <Icon name="search" size={16} class="shrink-0 text-ink/70" />
            <input
              id="filter-q"
              type="search"
              name="q"
              placeholder="Cari nama produk"
              autocomplete="off"
              class="w-full border-0 bg-transparent py-2 text-sm text-ink placeholder:text-ink/65 focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#27483B]"
            />
          </div>
        </div>
      </div>

      <p id="filter-count" class="label mt-4" aria-live="polite"></p>
    </div>

    <ol id="katalog-list" class="border-b border-sage">
      {products.map((p, i) => <ProductRow p={p} index={i} group={groupOf(p.name)} />)}
    </ol>

    <!-- State kosong -->
    <div id="empty" hidden class="border border-sage bg-sage/25 px-6 py-10 text-center">
      <Icon name="search" size={28} class="mx-auto text-ink/65" />
      <p class="mt-4 text-base font-medium tracking-tight text-ink">Tidak ada produk cocok</p>
      <p class="mx-auto mt-2 max-w-[52ch] text-sm leading-relaxed text-ink/65">
        Coba kata kunci lain atau ubah filter kategori. Untuk daftar lengkap, hubungi admin via WhatsApp.
      </p>
      <a
        href={emptyCta}
        rel="noopener"
        data-wa
        class="mt-5 inline-flex min-h-[44px] items-center gap-2 bg-accent px-5 text-sm font-medium text-paper active:scale-[0.98]"
      >
        <Icon name="whatsapp" size={16} />
        <span>Tanya katalog lengkap</span>
      </a>
    </div>

    <p class="mt-8 text-sm leading-relaxed text-ink/65">
      Belum menemukan yang dicari?
      <a href={emptyCta} rel="noopener" data-wa class="text-ink underline decoration-rust decoration-1 underline-offset-4 hover:text-accent"
        >Tanya katalog lengkap via WhatsApp</a
      >.
    </p>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const rows = Array.from(document.querySelectorAll('#katalog-list > li')) as HTMLElement[];
      const btns = Array.from(document.querySelectorAll('.filter-btn')) as HTMLButtonElement[];
      const input = document.getElementById('filter-q') as HTMLInputElement | null;
      const count = document.getElementById('filter-count');
      const empty = document.getElementById('empty');
      let group = 'Semua';

      const apply = () => {
        const q = (input?.value ?? '').trim().toLowerCase();
        let shown = 0;
        rows.forEach((row) => {
          const g = (row.dataset.group ?? '').toLowerCase();
          const name = (row.dataset.name ?? '').toLowerCase();
          const okGroup = group === 'Semua' || g === group.toLowerCase();
          const okQuery = !q || name.includes(q) || g.includes(q);
          const show = okGroup && okQuery;
          row.hidden = !show;
          if (show) shown++;
        });
        if (count) count.textContent = `Menampilkan ${shown} dari ${rows.length} produk`;
        if (empty) empty.hidden = shown !== 0;
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === group)));
      };

      btns.forEach((b) =>
        b.addEventListener('click', () => {
          group = b.dataset.filter ?? 'Semua';
          apply();
        }),
      );
      input?.addEventListener('input', apply);
      apply();
    });
  </script>
</BaseLayout>
