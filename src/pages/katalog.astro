---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, products, waLink } from '../data/business';
---
<BaseLayout title={`Katalog — ${business.title}`} description={`Katalog sementara ${business.name}: ${products.length} item placeholder ber-disclaimer, info resmi menyusul.`} canonicalPath="/katalog" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <p class="text-sm font-medium text-sky-500 reveal">Katalog Sementara</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-extrabold text-white max-w-[20ch] reveal d-1">Daftar Produk {business.name}</h1>
    <p class="mt-3 text-base text-zinc-400 leading-relaxed max-w-[65ch]">Cockpit hemat: daftar baris tanpa kartu. Semua item placeholder + disclaimer — bukan acuan harga. Info resmi menyusul.</p>
    <div class="refract mt-8 bg-zinc-900 border border-white/10 rounded-[2rem] divide-y divide-white/10 overflow-hidden reveal d-2">
      {products.map((p) => (
        <div class="flex items-center gap-4 p-4 md:p-5 transition-all duration-300 hover:bg-white/5">
          <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl overflow-hidden bg-zinc-800 shrink-0"><img src={p.image} alt={p.alt} width={p.w} height={p.h} loading="lazy" class="w-full h-full object-cover" /></div>
          <div class="min-w-0 flex-1">
            <p class="text-[11px] font-medium text-sky-500">{p.badge} • {p.stock}</p>
            <h2 class="font-semibold tracking-tight text-white truncate">{p.name}</h2>
            <p class="text-sm text-zinc-500">{p.price} • <span class="text-xs">{p.source}</span></p>
          </div>
          <a href={waLink(`Halo ${business.name}, saya mau tanya ${p.name} (${p.price}).`)} class="shrink-0 border border-white/20 text-white px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300 hover:border-white/60 active:scale-[0.98]">Tanya</a>
        </div>
      ))}
    </div>
    <div class="refract mt-6 bg-zinc-900 border border-dashed border-white/20 rounded-[2rem] p-10 text-center reveal d-3">
      <svg class="mx-auto text-zinc-500" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M8 11h6"/></svg>
      <p class="mt-4 font-bold tracking-tight text-lg text-white">Belum ketemu yang dicari?</p>
      <p class="mt-2 text-base text-zinc-400 max-w-[65ch] mx-auto">Wajar — katalog masih placeholder. Minta update info resmi atau tanya via WA sementara.</p>
      <a href={waLink(`Halo ${business.name}, saya cari produk lain / minta update info resmi.`)} class="mt-5 inline-block bg-sky-700 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Tanya via WA</a>
    </div>
  </section>
</BaseLayout>
