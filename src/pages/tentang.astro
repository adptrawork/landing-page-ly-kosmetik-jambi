---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, socials, storeNotes, waLink } from '../data/business';
const embed = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const cta = waLink(`Halo ${business.name}, saya mau tanya info toko.`);
---
<BaseLayout title={`Tentang — ${business.title}`} description={`Status info ${business.name}: alamat & kontak menyusul, cara verifikasi & WA sementara.`} canonicalPath="/tentang" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <p class="text-sm font-medium text-sky-500 reveal">Tentang — Info Menyusul</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-extrabold text-white max-w-[20ch] reveal d-1">{business.name}</h1>
    <p class="mt-3 text-base text-zinc-400 leading-relaxed max-w-[65ch]">Belum ada data publik terverifikasi. Semua status jujur di bawah — bukan disembunyikan.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7 reveal d-2">
        <div class="refract bg-zinc-900 border border-white/10 rounded-[2rem] overflow-hidden">
          <div class="aspect-video bg-zinc-800"><iframe title={`Peta ${business.name}`} src={embed} loading="lazy" class="w-full h-full opacity-80"></iframe></div>
          <div class="p-8">
            <h2 class="font-bold text-white tracking-tight text-lg">Alamat & Jam (menyusul)</h2>
            <p class="mt-3 text-base text-zinc-400 leading-relaxed">{business.address}</p>
            <p class="mt-1 text-xs font-medium text-sky-500">Alamat: {business.addressStatus}</p>
            <p class="mt-4 text-base text-zinc-400">{business.hours}</p>
            <p class="mt-1 text-xs font-medium text-sky-500">Jam: {business.hoursStatus}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={cta} class="bg-sky-700 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Tanya via WA</a>
              <a href={business.mapsUrl} class="border border-white/20 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Cari di Maps</a>
            </div>
          </div>
        </div>
      </div>
      <div class="md:col-span-5 flex flex-col gap-6 reveal d-3">
        <div class="refract bg-zinc-900 border border-white/10 rounded-[2rem] p-8">
          <h2 class="font-bold text-white tracking-tight text-lg">Akun Resmi</h2>
          <ul class="mt-3 flex flex-col gap-2 text-sm text-zinc-400">{socials.map((s) => (<li><a href={s.url} class="underline underline-offset-4 text-white">{s.label}</a> <span>— {s.note}</span></li>))}</ul>
        </div>
        <div class="refract bg-zinc-900 border border-dashed border-white/20 rounded-[2rem] p-8 text-center">
          <svg class="mx-auto text-zinc-500" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M8 11h6"/></svg>
          <h2 class="mt-3 font-bold text-white tracking-tight">Catatan Keterbukaan</h2>
          <ul class="mt-3 text-sm text-zinc-400 leading-relaxed list-disc pl-5 text-left">{storeNotes.map((n) => (<li>{n}</li>))}</ul>
          <a href={cta} class="mt-5 inline-block bg-sky-700 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Bantu Verifikasi</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
