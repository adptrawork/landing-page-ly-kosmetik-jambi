---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Kicker from '../components/ui/Kicker.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import StoreInfo from '../components/ui/StoreInfo.astro';
import Steps from '../components/ui/Steps.astro';
import MapFacade from '../components/ui/MapFacade.astro';
import { business, storeNotes, waLink } from '../data/business';

const title = 'Tentang Ly Kosmetik Jambi — Info Toko, Kontak & Lokasi';
const description = `Halaman tentang ${business.name}: ringkasan informasi toko, status data alamat dan jam, peta lokasi, serta kontak WhatsApp admin untuk pertanyaan stok grosir.`;

const embed = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const cta = waLink(`Halo ${business.name}, saya mau tanya rute dan stok produk grosir.`);

const steps = [
  { t: 'Tulis nama & kebutuhan', d: 'Isi nama dan kebutuhan produk pada formulir di halaman ini.' },
  { t: 'Kirim via WhatsApp', d: 'Pesan WhatsApp akan terbuka dengan isi yang sudah tertulis otomatis.' },
  { t: 'Tunggu balasan admin', d: 'Admin mengonfirmasi ketersediaan, harga, dan cara pengambilan atau pengiriman.' },
];
---

<!-- Ref: utilitarian catalog, informasi toko <dl> ber-rule + MapFacade + NAP -->

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/tentang"
  image={business.ogImage}
  breadcrumbs={[{ name: 'Beranda', path: '/' }, { name: 'Tentang', path: '/tentang' }]}
>
  <section class="shell py-10 sm:py-14 md:py-16" aria-labelledby="tentang-h">
    <Kicker no="Tentang" label={`${business.category} — ${business.city}`} />
    <h1
      id="tentang-h"
      class="mt-4 max-w-[24ch] text-[2.1rem] font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl"
    >
      {business.name}
    </h1>
    <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-ink/70">
      Katalog grosir kosmetik dan skincare untuk wilayah Jambi. Sebagian data publik toko — alamat, jam operasional, dan
      nomor WhatsApp — masih placeholder dan belum terverifikasi; produk dan harga di situs ini bersifat estimasi, bukan
      acuan harga final.
    </p>
  </section>

  <!-- 01 Informasi toko -->
  <section class="shell pb-10 sm:pb-14" aria-labelledby="info-h">
    <div class="border-t border-ink/15 pt-6">
      <SectionHead
        no="01"
        kicker="Informasi toko"
        title="Data toko yang tersedia"
        desc="Nilai placeholder ditampilkan apa adanya, tanpa mengisi data yang belum dikonfirmasi."
        id="info-h"
      />
    </div>
    <div class="mt-8 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <StoreInfo />
      </div>
      <div class="lg:col-span-5">
        <h3 class="text-base font-medium tracking-tight text-ink">Catatan toko</h3>
        <ul class="mt-4 border-t border-sage">
          {
            storeNotes.map((n) => (
              <li class="flex gap-3 border-b border-sage py-3 text-sm leading-relaxed text-ink/70">
                <span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 bg-rust"></span>
                <span>{n}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm leading-relaxed text-ink/65">
          Harga dapat berubah — konfirmasi via WhatsApp toko.
        </p>
      </div>
    </div>
  </section>

  <!-- 02 Tanya stok cepat -->
  <section class="shell pb-10 sm:pb-14" aria-labelledby="form-h">
    <div class="border-t border-ink/15 pt-6">
      <SectionHead
        no="02"
        kicker="Tanya stok"
        title="Kirim pertanyaan via WhatsApp"
        desc="Isi singkat, lalu chat WhatsApp terbuka otomatis dengan pesan Anda."
        id="form-h"
      />
    </div>

    <form id="wa-form" class="mt-8 max-w-xl border border-sage bg-sage/20 p-5 sm:p-6" novalidate>
      <div id="f-nama-wrap">
        <label for="f-nama" class="text-sm font-medium text-ink">Nama</label>
        <input
          id="f-nama"
          name="nama"
          type="text"
          autocomplete="name"
          placeholder="Nama Anda"
          class="mt-1 w-full border border-ink/25 bg-paper px-4 py-2 text-sm text-ink placeholder:text-ink/40 focus:border-accent focus:outline-none"
        />
        <p class="field-err" role="alert">Nama wajib diisi (min. 2 huruf).</p>
      </div>

      <div id="f-pesan-wrap" class="mt-4">
        <label for="f-pesan" class="text-sm font-medium text-ink">Kebutuhan</label>
        <textarea
          id="f-pesan"
          name="pesan"
          rows="3"
          placeholder="Contoh: stok sunscreen dan harga grosir"
          class="mt-1 w-full border border-ink/25 bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/40 focus:border-accent focus:outline-none"></textarea>
        <p class="field-err" role="alert">Tulis kebutuhan Anda dulu (min. 5 karakter).</p>
      </div>

      <button
        type="submit"
        class="mt-5 inline-flex min-h-[48px] items-center gap-2 bg-accent px-6 text-sm font-medium text-paper transition-transform duration-200 hover:bg-ink active:scale-[0.98]"
      >
        <Icon name="whatsapp" size={17} />
        <span>Kirim via WhatsApp</span>
      </button>
      <p class="label mt-3">Pesan dibuka di aplikasi WhatsApp Anda — tidak ada data yang disimpan di situs ini.</p>
    </form>
  </section>

  <!-- 03 Cara order -->
  <section class="shell pb-10 sm:pb-14" aria-labelledby="cara-h">
    <div class="border-t border-ink/15 pt-6">
      <SectionHead no="03" kicker="Cara order" title="Alur pemesanan" id="cara-h" />
    </div>
    <div class="mt-8">
      <Steps steps={steps} />
    </div>
  </section>

  <!-- 04 Lokasi -->
  <section class="shell pb-14 sm:pb-20" aria-labelledby="lokasi-h">
    <div class="border-t border-ink/15 pt-6">
      <SectionHead
        no="04"
        kicker="Lokasi"
        title="Peta dan kontak"
        desc="Peta dimuat setelah diklik. Alamat pasti masih placeholder."
        id="lokasi-h"
      />
    </div>
    <div class="mt-8 grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <MapFacade embed={embed} />
      </div>
      <div class="lg:col-span-5">
        <dl class="border-t border-sage">
          <div class="flex gap-6 border-b border-sage py-3">
            <dt class="label w-24 shrink-0 pt-0.5">Alamat</dt>
            <dd class="text-sm text-ink/80">{business.address}</dd>
          </div>
          <div class="flex gap-6 border-b border-sage py-3">
            <dt class="label w-24 shrink-0 pt-0.5">Instagram</dt>
            <dd class="text-sm text-ink/80">{business.instagramLabel}</dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={cta}
            rel="noopener"
            data-wa
            class="inline-flex min-h-[48px] items-center gap-2 bg-accent px-6 text-sm font-medium text-paper transition-transform duration-200 hover:bg-ink active:scale-[0.98]"
          >
            <Icon name="whatsapp" size={17} />
            <span>Chat WhatsApp</span>
          </a>
          <a
            href={business.mapsUrl}
            rel="noopener"
            class="inline-flex min-h-[48px] items-center gap-2 border border-ink/25 px-6 text-sm font-medium text-ink transition-colors hover:border-ink active:scale-[0.98]"
          >
            <Icon name="pin" size={17} />
            <span>Cari di Maps</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ storePhone: business.phone, storeName: business.name }}>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('wa-form');
      const nama = document.getElementById('f-nama');
      const pesan = document.getElementById('f-pesan');
      const wNama = document.getElementById('f-nama-wrap');
      const wPesan = document.getElementById('f-pesan-wrap');
      if (!form || !nama || !pesan) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const n = (nama.value || '').trim();
        const p = (pesan.value || '').trim();
        const okN = n.length >= 2;
        const okP = p.length >= 5;
        wNama?.classList.toggle('field-invalid', !okN);
        wPesan?.classList.toggle('field-invalid', !okP);
        if (!okN || !okP) {
          (!okN ? nama : pesan).focus();
          return;
        }
        const text = encodeURIComponent(`Halo ${storeName}, saya ${n}. ${p}`);
        window.open(`https://wa.me/${storePhone}?text=${text}`, '_blank', 'noopener');
      });
    });
  </script>
</BaseLayout>
