---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Kicker from '../components/ui/Kicker.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import ProductRow from '../components/ui/ProductRow.astro';
import StoreInfo from '../components/ui/StoreInfo.astro';
import Steps from '../components/ui/Steps.astro';
import Faq from '../components/ui/Faq.astro';
import MapFacade from '../components/ui/MapFacade.astro';
import { business, products, waLink } from '../data/business';
import { groupedCatalog, groupOf } from '../data/catalog';

const heroCta = waLink(`Halo ${business.name}, saya mau tanya stok produk grosir. Apakah ready?`);
const catalogCta = waLink(`Halo ${business.name}, boleh minta daftar harga grosir lengkapnya?`);
const embed = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;

const facts = [
  { k: 'Isi katalog', v: `${products.length} jenis produk`, note: 'Skincare & perawatan harian' },
  { k: 'Pemesanan', v: 'Via WhatsApp admin', note: 'Stok & harga dikonfirmasi admin' },
  { k: 'Status harga', v: 'Estimasi', note: 'Info menyusul — belum final' },
];

const steps = [
  { t: 'Pilih jenis produk', d: 'Telusuri daftar katalog bernomor di halaman ini atau buka Katalog untuk memfilter per kategori.' },
  { t: 'Kirim pesan WhatsApp', d: 'Sebutkan nama produk dan jumlah yang dicari; admin memeriksa ketersediaan stok grosir.' },
  { t: 'Konfirmasi harga & stok', d: 'Harga final dan cara pengambilan atau pengiriman dikonfirmasi admin via WhatsApp sebelum order.' },
];

const faqs = [
  { q: 'Apakah harga di halaman ini sudah final?', a: 'Belum. Semua harga masih estimasi dan belum terverifikasi. Harga final selalu dikonfirmasi admin via WhatsApp sebelum order.' },
  { q: 'Bagaimana cara memesan?', a: 'Pilih produk pada daftar katalog, tekan tombol Tanya via WA pada baris produk, lalu sebutkan nama produk dan jumlahnya.' },
  { q: 'Di mana alamat dan jam bukanya?', a: 'Alamat, jam operasional, dan nomor admin masih placeholder (info menyusul). Sementara ini gunakan tombol WhatsApp atau pencarian lokasi di Google Maps.' },
  { q: 'Apakah tersedia harga grosir?', a: 'Situs ini disiapkan sebagai katalog grosir. Ketentuan dan potongan jumlah besar belum terverifikasi; tanyakan langsung ke admin melalui WhatsApp.' },
];
---

<!-- Ref: utilitarian catalog, utility bar + hero asimetris + list bernomor + data mono -->

<BaseLayout title={business.title} description={business.description} canonicalPath="/" image={business.ogImage}>
  <!-- Ref: taped polaroid editorial — magazine spread, rotated polaroid, handwritten price tag, ruled margin -->
  <!-- 01 Hero editorial (bukan hero center) -->
  <section class="shell py-10 sm:py-14 md:py-20 hero-editorial" aria-labelledby="hero-h">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12 items-start">
      <div class="lg:col-span-7 hero-margin">
        <Kicker label="Katalog grosir · Kota Jambi" />
        <h1
          id="hero-h"
          class="hero-headline mt-4 max-w-[22ch] text-[2.1rem] font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl"
        >
          Katalog grosir kosmetik Ly Kosmetik Jambi
        </h1>
        <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-ink/70">
          {products.length} jenis produk skincare tersusun rapi sebagai daftar bernomor — dari rangkaian brightening, clay
          mask, pelembap, serum, sunscreen, toner, sampai krim. Harga dan stok masih estimasi; konfirmasi tiap item
          langsung via WhatsApp.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={heroCta}
            rel="noopener"
            data-wa
            class="inline-flex min-h-[48px] items-center justify-center gap-2 bg-accent px-6 text-sm font-medium text-paper transition-transform duration-200 hover:bg-ink active:scale-[0.98]"
          >
            <Icon name="whatsapp" size={17} />
            <span>Tanya stok via WhatsApp</span>
          </a>
          <a
            href="#katalog-list"
            class="inline-flex min-h-[48px] items-center justify-center gap-2 border border-ink/25 px-6 text-sm font-medium text-ink transition-colors hover:border-ink active:scale-[0.98]"
          >
            <span>Lihat daftar katalog</span>
            <Icon name="arrow" size={17} />
          </a>
        </div>

        <p class="label mt-6">Status data: info menyusul — alamat, jam, dan nomor resmi belum terverifikasi</p>
      </div>

      <div class="lg:col-span-5 relative">
        <figure class="polaroid">
          <span class="tape" aria-hidden="true"></span>
          <img
            src={business.ogImage}
            alt="Ilustrasi katalog produk skincare Ly Kosmetik Jambi"
            width="800"
            height="600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="label mt-2">
            Foto: ilustrasi katalog — ganti dengan foto toko asli setelah verifikasi
          </figcaption>
          <span class="price-tag num">{products[0].price}</span>
        </figure>

        <dl class="mt-6 border-t border-sage">
          {
            facts.map((f) => (
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-sage py-3">
                <dt class="label">{f.k}</dt>
                <dd class="num text-sm text-ink">
                  {f.v}
                  <span class="label ml-2">{f.note}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- 02 Katalog sebagai list bernomor -->
  <section class="shell py-10 sm:py-14" aria-labelledby="katalog-h">
    <div id="katalog-list" class="scroll-mt-6">
      <SectionHead
        no="01"
        kicker="Katalog"
        title="Daftar produk bernomor"
        desc={`${products.length} baris produk dengan jenis, harga estimasi, dan tombol tanya stok. Gunakan halaman Katalog untuk memfilter per kategori.`}
        id="katalog-h"
      />
    </div>

    <ol class="mt-8 border-b border-sage">
      {products.map((p, i) => <ProductRow p={p} index={i} group={groupOf(p.name)} />)}
    </ol>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href="/katalog"
        class="inline-flex min-h-[48px] items-center gap-2 border border-accent px-6 text-sm font-medium text-accent transition-colors hover:bg-accent hover:text-paper active:scale-[0.98]"
      >
        <span>Buka katalog dengan filter</span>
        <Icon name="arrow" size={17} />
      </a>
      <a
        href={catalogCta}
        rel="noopener"
        data-wa
        class="inline-flex min-h-[48px] items-center text-sm text-ink underline decoration-rust decoration-1 underline-offset-4 hover:text-accent"
      >
        Minta daftar harga grosir via WA
      </a>
    </div>
  </section>

  <!-- 03 Informasi toko ringkas -->
  <section class="shell py-10 sm:py-14" aria-labelledby="toko-h">
    <SectionHead
      no="02"
      kicker="Informasi toko"
      title="Alamat, jam, dan kontak"
      desc="Ringkasan data toko yang tersedia saat ini. Semua nilai placeholder ditampilkan apa adanya."
      id="toko-h"
    />
    <div class="mt-8">
      <StoreInfo />
    </div>
  </section>

  <!-- 04 Kategori grosir -->
  <section class="shell py-10 sm:py-14" aria-labelledby="kategori-h">
    <SectionHead
      no="03"
      kicker="Kategori grosir"
      title="Kelompok produk di katalog"
      desc="Pengelompokan jenis produk untuk memudahkan permintaan grosir. Jumlah mengikuti isi katalog saat ini."
      id="kategori-h"
    />

    <ol class="mt-8 border-t border-sage">
      {
        groupedCatalog.map((g, i) => (
          <li class="reveal grid grid-cols-[2.5rem_minmax(0,1fr)_auto] items-baseline gap-x-4 border-b border-sage py-4 md:gap-x-8" style={`--i:${i}`}>
            <span class="num text-sm text-accent">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-base font-medium tracking-tight text-ink">{g.name}</span>
            <span class="num text-sm text-ink/55">{g.items.length} produk</span>
          </li>
        ))
      }
    </ol>

    <p class="mt-4 text-sm leading-relaxed text-ink/65">
      Ketersediaan tiap kategori belum terverifikasi —
      <a href={catalogCta} rel="noopener" data-wa class="text-ink underline decoration-rust decoration-1 underline-offset-4 hover:text-accent">konfirmasi via WhatsApp</a>.
    </p>
  </section>

  <!-- 05 Cara order -->
  <section class="shell py-10 sm:py-14" aria-labelledby="cara-h">
    <SectionHead
      no="04"
      kicker="Cara order"
      title="Tiga langkah pemesanan"
      desc="Semua permintaan dikonfirmasi admin via WhatsApp sebelum diproses."
      id="cara-h"
    />
    <div class="mt-8">
      <Steps steps={steps} />
    </div>
  </section>

  <!-- 06 Lokasi & kontak -->
  <section class="shell py-10 sm:py-14" aria-labelledby="lokasi-h">
    <SectionHead
      no="05"
      kicker="Lokasi & kontak"
      title="Temukan dan hubungi toko"
      desc="Peta dimuat setelah diklik agar halaman tetap ringan. Alamat pasti masih placeholder."
      id="lokasi-h"
    />
    <div class="mt-8 grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <MapFacade embed={embed} />
      </div>
      <div class="lg:col-span-5">
        <dl class="border-t border-sage">
          <div class="flex gap-6 border-b border-sage py-3">
            <dt class="label w-24 shrink-0 pt-0.5">Alamat</dt>
            <dd class="text-sm text-ink/80">{business.address}</dd>
          </div>
          <div class="flex gap-6 border-b border-sage py-3">
            <dt class="label w-24 shrink-0 pt-0.5">Jam</dt>
            <dd class="text-sm text-ink/80">{business.hours} — {business.hoursStatus}</dd>
          </div>
          <div class="flex gap-6 border-b border-sage py-3">
            <dt class="label w-24 shrink-0 pt-0.5">WhatsApp</dt>
            <dd class="num text-sm text-ink/80">{business.phoneDisplay}</dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={heroCta}
            rel="noopener"
            data-wa
            class="inline-flex min-h-[48px] items-center gap-2 bg-accent px-6 text-sm font-medium text-paper transition-transform duration-200 hover:bg-ink active:scale-[0.98]"
          >
            <Icon name="whatsapp" size={17} />
            <span>Chat WhatsApp</span>
          </a>
          <a
            href={business.mapsUrl}
            rel="noopener"
            class="inline-flex min-h-[48px] items-center gap-2 border border-ink/25 px-6 text-sm font-medium text-ink transition-colors hover:border-ink active:scale-[0.98]"
          >
            <Icon name="pin" size={17} />
            <span>Cari di Maps</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 FAQ -->
  <section class="shell py-10 sm:py-14" aria-labelledby="faq-h">
    <SectionHead no="06" kicker="FAQ" title="Sering ditanyakan" desc="Jawaban singkat sebelum menghubungi admin." id="faq-h" />
    <div class="mt-8">
      <Faq items={faqs} />
    </div>
  </section>
</BaseLayout>
