---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, products, waLink } from '../data/business';
const heroCta = waLink(`Halo ${business.name}, saya mau tanya info toko.`);
const featured = products.slice(0, 4);
---
<BaseLayout title={business.title} description={business.description} canonicalPath="/" image={business.ogImage}>
  <!-- hero text-mask-reveal -->
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="min-h-[88dvh] py-14 flex flex-col justify-center">
      <p class="flex items-center gap-2 text-sm font-medium text-sky-500 reveal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        <span>Info menyusul • {business.city} • Estimasi 09.00–21.00</span>
      </p>
      <h1 class="mask-text mt-4 text-4xl md:text-6xl tracking-tighter leading-none font-extrabold reveal d-1" aria-label="Ly Kosmetik Jambi — Info Toko Menyusul">Ly Kosmetik Jambi — Info Toko Menyusul</h1>
      <p class="mt-5 text-base text-zinc-400 leading-relaxed max-w-[65ch] reveal d-2">Halaman ini memakai foto toko sebagai tekstur judul. Alamat, WA & jam resmi masih menyusul — cari di Maps atau tanya via WA sementara. Produk di bawah placeholder + disclaimer.</p>
      <div class="mt-8 flex flex-wrap gap-3 reveal d-3">
        <a href={heroCta} class="bg-sky-700 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">Tanya via WhatsApp</a>
        <a href="/katalog" class="border border-white/20 text-zinc-100 px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:border-white/60 active:scale-[0.98]">Lihat Katalog</a>
      </div>
      <div class="mt-8 flex divide-x divide-white/10 border-t border-white/10 pt-5 text-sm text-zinc-400 reveal d-4">
        <div class="pr-6"><p class="font-bold text-white">{business.rating}</p><p>Rating awal</p></div>
        <div class="px-6"><p class="font-bold text-white">{products.length}</p><p>Item placeholder</p></div>
        <div class="pl-6"><p class="font-bold text-white">Segera</p><p>Info resmi</p></div>
      </div>
    </div>
  </section>

  <!-- katalog list divide-y tanpa kartu -->
  <section class="max-w-7xl mx-auto px-4 py-12 w-full">
    <p class="text-sm font-medium text-sky-500 reveal">Sorotan Katalog</p>
    <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold text-white reveal d-1">Daftar ringkas hemat</h2>
    <p class="mt-3 text-base text-zinc-400 leading-relaxed max-w-[65ch]">Tanpa kartu — baris ramping dengan foto kecil. <a class="underline underline-offset-4 text-white" href="/katalog">Lihat semua {products.length} item</a></p>
    <div class="refract mt-8 bg-zinc-900 border border-white/10 rounded-[2rem] divide-y divide-white/10 overflow-hidden">
      {featured.map((p, i) => (
        <div class:list={["reveal flex items-center gap-4 p-4 md:p-5 transition-all duration-300 hover:bg-white/5"]} style={`animation-delay:${0.08 + i * 0.07}s`}>
          <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl overflow-hidden bg-zinc-800 shrink-0"><img src={p.image} alt={p.alt} width={p.w} height={p.h} loading="lazy" class="w-full h-full object-cover" /></div>
          <div class="min-w-0 flex-1">
            <p class="text-[11px] font-medium text-sky-500">{p.badge} • {p.stock}</p>
            <h3 class="font-semibold tracking-tight text-white truncate">{p.name}</h3>
            <p class="text-sm text-zinc-500">{p.price} • <span class="text-xs">{p.source}</span></p>
          </div>
          <a href={waLink(`Halo ${business.name}, saya mau tanya ${p.name} (${p.price}).`)} class="shrink-0 border border-white/20 text-white px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300 hover:border-white/60 active:scale-[0.98]">Tanya</a>
        </div>
      ))}
    </div>
  </section>

  <!-- empty-state cantik -->
  <section class="max-w-7xl mx-auto px-4 py-12 w-full">
    <div class="refract bg-zinc-900 border border-white/10 rounded-[2.5rem] p-8 md:p-12 text-center reveal">
      <svg class="mx-auto" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M8 11h6"/></svg>
      <h2 class="mt-4 text-2xl md:text-3xl tracking-tighter leading-none font-bold text-white">Data resmi belum tampil? Wajar.</h2>
      <p class="mt-3 text-base text-zinc-400 leading-relaxed max-w-[65ch] mx-auto">Status halaman ini Info menyusul. Bantu verifikasi bila kenal pemilik toko — atau jelajahi <a class="underline underline-offset-4 text-white" href="/katalog">katalog sementara</a>, <a class="underline underline-offset-4 text-white" href="/promo">promo</a>, <a class="underline underline-offset-4 text-white" href="/tentang">tentang</a>.</p>
      <a href={heroCta} class="mt-6 inline-block bg-sky-700 text-white px-8 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Minta Update Info</a>
    </div>
  </section>
</BaseLayout>
