---
import BaseHead from '../components/BaseHead.astro';
import Icon from '../components/ui/Icon.astro';
import '../styles/global.css';
import { business, waLink } from '../data/business';

interface Breadcrumb {
  name: string;
  path: string;
}
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  breadcrumbs?: Breadcrumb[];
}

const { title, description, canonicalPath = '/', image, breadcrumbs } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://lykosmetik-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
const cta = waLink(`Halo ${business.name}, saya mau tanya stok produk grosir. Apakah ready?`);
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/katalog', label: 'Katalog' },
  { href: '/promo', label: 'Promo' },
  { href: '/tentang', label: 'Tentang' },
];
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} breadcrumbs={breadcrumbs} />
  </head>
  <body class="min-h-[100dvh] bg-paper text-ink antialiased">
    <a
      href="#konten"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:inline-flex focus:min-h-[44px] focus:items-center focus:rounded-sm focus:border focus:border-accent focus:bg-paper focus:px-4 focus:text-sm focus:font-medium focus:text-accent"
      >Lewati ke konten</a
    >

    <!-- Ref: utility bar tipis (jam + WA + navigasi cepat), mono kecil, bukan sticky besar -->
    <div class="border-b border-ink/15 bg-ink text-paper">
      <div class="shell flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2">
        <p class="label !text-paper/75 flex items-center gap-2">
          <Icon name="clock" size={14} />
          <span>Jam toko: {business.hoursStatus} — konfirmasi via WhatsApp</span>
        </p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
          <nav aria-label="Navigasi cepat" class="hidden items-center gap-x-5 sm:flex">
            <a href="/katalog" class="label !text-paper/75 transition-opacity hover:!text-paper">Katalog grosir</a>
            <a href="/promo" class="label !text-paper/75 transition-opacity hover:!text-paper">Promo</a>
          </nav>
          <a
            href={cta}
            rel="noopener"
            class="label !text-paper flex items-center gap-2 transition-opacity hover:opacity-80"
            data-wa
          >
            <Icon name="whatsapp" size={14} />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Ref: header ringkas — brand + nav utama, tanpa sticky berat -->
    <header class="border-b border-sage bg-paper">
      <nav class="shell" aria-label="Navigasi utama">
        <input id="nav-toggle" type="checkbox" class="peer sr-only" />
        <div class="nav-bar flex items-center justify-between gap-3 py-3">
          <a href="/" class="flex items-baseline gap-2 leading-none" aria-label={`${business.name} — beranda`}>
            <span class="text-lg font-semibold tracking-tight text-ink">LY Kosmetik</span>
            <span class="label hidden sm:inline">Grosir · Jambi</span>
          </a>

          <div class="hidden items-center gap-6 md:flex">
            {nav.map((n) => (
              <a
                href={n.href}
                aria-current={active(n.href) ? 'page' : undefined}
                class:list={[
                  'min-h-[44px] inline-flex items-center text-sm transition-colors',
                  active(n.href)
                    ? 'font-medium text-accent underline decoration-rust decoration-1 underline-offset-[6px]'
                    : 'text-ink/70 hover:text-ink',
                ]}
              >
                {n.label}
              </a>
            ))}
          </div>

          <div class="flex items-center gap-2">
            <a
              href={cta}
              rel="noopener"
              class="hidden min-h-[44px] items-center gap-2 border border-accent bg-accent px-4 text-sm font-medium text-paper transition-transform duration-200 hover:bg-ink active:scale-[0.98] sm:inline-flex"
              data-wa
            >
              <Icon name="whatsapp" size={16} />
              <span>Tanya via WA</span>
            </a>
            <label
              for="nav-toggle"
              id="nav-label"
              aria-label="Buka atau tutup menu navigasi"
             
             
              class="inline-flex min-h-[44px] min-w-[44px] cursor-pointer items-center justify-center border border-ink/20 text-ink transition-colors hover:border-ink md:hidden"
            >
              <Icon name="menu" size={20} stroke={2} class="icon-open" />
              <Icon name="close" size={20} stroke={2} class="icon-close hidden" />
            </label>
          </div>
        </div>

        <div class="nav-panel md:hidden" id="menu-mobile">
          <div>
            <div class="flex flex-col pb-3">
              {nav.map((n) => (
                <a
                  href={n.href}
                  aria-current={active(n.href) ? 'page' : undefined}
                  class:list={[
                    'flex min-h-[44px] w-full items-center border-t border-sage py-3 text-base transition-colors',
                    active(n.href) ? 'font-medium text-accent' : 'text-ink/80 hover:text-ink',
                  ]}
                >
                  {n.label}
                </a>
              ))}
              <a
                href={cta}
                rel="noopener"
                class="mt-3 inline-flex min-h-[44px] items-center justify-center gap-2 bg-accent px-5 text-sm font-medium text-paper active:scale-[0.98] sm:hidden"
                data-wa
              >
                <Icon name="whatsapp" size={16} />
                <span>Tanya via WA</span>
              </a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main id="konten"><slot /></main>

    <!-- Ref: footer NAP ringkas -->
    <footer class="mt-16 border-t border-sage bg-paper sm:mt-24">
      <div class="shell grid gap-10 py-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="text-lg font-semibold tracking-tight text-ink">{business.name}</p>
          <p class="label mark mt-2">Grosir kosmetik & skincare — {business.city}</p>
          <dl class="mt-6 border-t border-sage text-sm">
            <div class="flex gap-4 border-b border-sage py-3">
              <dt class="label w-24 shrink-0 pt-0.5">Alamat</dt>
              <dd class="text-ink/80">{business.address}</dd>
            </div>
            <div class="flex gap-4 border-b border-sage py-3">
              <dt class="label w-24 shrink-0 pt-0.5">Telepon</dt>
              <dd class="num text-ink/80">{business.phoneDisplay}</dd>
            </div>
            <div class="flex gap-4 border-b border-sage py-3">
              <dt class="label w-24 shrink-0 pt-0.5">Instagram</dt>
              <dd class="text-ink/80">{business.instagramLabel}</dd>
            </div>
          </dl>
        </div>

        <nav class="md:col-span-4" aria-label="Navigasi footer">
          <p class="label">Halaman</p>
          <ul class="mt-4 flex flex-col">
            {nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  class="inline-flex min-h-[44px] items-center text-sm text-ink/80 underline-offset-4 transition-colors hover:text-accent hover:underline"
                  >{n.label}</a
                >
              </li>
            ))}
          </ul>
        </nav>

        <div class="md:col-span-3">
          <p class="label">Hubungi</p>
          <ul class="mt-4 flex flex-col gap-1">
            <li>
              <a
                href={cta}
                rel="noopener"
                data-wa
                class="inline-flex min-h-[44px] items-center gap-2 text-sm text-ink/80 underline-offset-4 transition-colors hover:text-accent hover:underline"
              >
                <Icon name="whatsapp" size={16} />
                <span>WhatsApp admin ({business.phoneDisplay})</span>
              </a>
            </li>
            <li>
              <a
                href={business.mapsUrl}
                rel="noopener"
                class="inline-flex min-h-[44px] items-center gap-2 text-sm text-ink/80 underline-offset-4 transition-colors hover:text-accent hover:underline"
              >
                <Icon name="pin" size={16} />
                <span>Cari lokasi di Google Maps</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="shell flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-sage py-5">
        <p class="label">© 2026 {business.name}</p>
        <p class="label">Harga dapat berubah — konfirmasi via WhatsApp</p>
      </div>
    </footer>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
        const label = document.getElementById('nav-label');
        if (toggle && label) {
          toggle.addEventListener('change', () => label.setAttribute('aria-expanded', toggle.checked ? 'true' : 'false'));
        }
        document.querySelectorAll('[data-mapfacade]').forEach((root) => {
          const btn = root.querySelector('[data-mapbtn]');
          if (!btn) return;
          btn.addEventListener(
            'click',
            () => {
              const frame = document.createElement('iframe');
              frame.src = root.getAttribute('data-src') || '';
              frame.title = root.getAttribute('data-title') || 'Peta toko';
              frame.loading = 'lazy';
              frame.className = 'h-full w-full border-0';
              root.replaceChildren(frame);
            },
            { once: true },
          );
        });
      });
    </script>
  </body>
</html>
